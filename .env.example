# Database connection string (PostgreSQL - Neon / Supabase / AWS / Local)
# In production with Neon: postgresql://<user>:<password>@<endpoint>.ap-southeast-1.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/foundapay"

# NextAuth / Auth.js encryption secret (generate with: openssl rand -base64 32)
AUTH_SECRET="your-32-character-random-secret-key-here"

# Canonical production URL (optional in Vercel, required for custom VPS/domains)
# NEXTAUTH_URL="https://your-domain.com"
