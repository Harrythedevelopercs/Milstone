generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  OWNER
  ACCOUNTANT
  EMPLOYEE
}

enum FeeBasis {
  GROSS
  AFTER_MERCHANT_CHARGES
}

enum FeeBearer {
  FOUNDAPAY
  CLIENT
}

enum MerchantFeeSource {
  MANUAL
  RULE_DEFAULT
}

// Main lifecycle + linked/special states live in one status field on Transaction.
// Linked events (refund/chargeback/void/hold/reserve/dispute) also get their own
// row in RefundChargebackVoid or Adjustment for full detail; this enum reflects
// the transaction's current condition.
enum TransactionStatus {
  ENTERED
  SUBMITTED
  APPROVED
  PROCESSED
  SETTLED
  CLIENT_PAYABLE
  PARTIALLY_PAID
  PAID
  CLOSED
  HOLD
  RESERVE
  VOID
  REFUNDED
  CHARGEBACK
  DISPUTED
  REJECTED
  DETAILS_REQUESTED
}

enum ApprovalAction {
  SUBMIT
  APPROVE
  REJECT
  REQUEST_DETAILS
}

enum MonthCloseStatus {
  OPEN
  CLOSED
  REOPENED
}

// BankAccount doubles as the ledger target for fiat bank, USDT wallets, and cash
// drawers so "cash position" can be reported as one unified list (see brief section 5).
enum AccountType {
  BANK
  USDT
  CASH
}

// Per-company relationship status (from the user's tracking sheet), separate
// from the `active` flag below -- active controls whether an account is
// selectable elsewhere in the app (forms/dropdowns); this only describes
// whether the company currently has/had a real relationship with that bank.
enum BankAccountStatus {
  ACTIVE
  SUSPENDED
  NOT_APPLIED
}

enum RcvType {
  REFUND
  CHARGEBACK
  VOID
}

enum RcvStatus {
  OPEN
  RESOLVED
  DISPUTED
}

enum LedgerSourceType {
  TRANSACTION
  RCV
  PAYOUT
  SETTLEMENT_BATCH
  EXPENSE
  INTERNAL_TRANSFER
  THIRD_PARTY_SETTLEMENT
  ADJUSTMENT
  PRODUCT_SERVICE_SALE
  MONTH_CLOSE
  MANUAL
}

enum PartnerLedgerKind {
  PROFIT_ENTITLEMENT
  DRAWING
  LOAN
  LOAN_REPAYMENT
  ADJUSTMENT
}

enum AdjustmentTargetType {
  CLIENT
  MERCHANT
  BANK
  EMPLOYEE_PARTNER
  PARTNER
  BUSINESS_UNIT
  THIRD_PARTY
}

enum SettlementBatchStatus {
  OPEN
  RECONCILED
  DIFFERENCE
}

enum ThirdPartyDirection {
  CLIENT_PAYABLE_TO_THIRD_PARTY
  FP_PAID_THIRD_PARTY
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

// ============================================================================
// AUTH / USERS
// ============================================================================

// Credentials + JWT session strategy (no NextAuth DB adapter) -- no Account,
// Session, or VerificationToken tables needed. See schema notes.
model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String    @map("password_hash")
  name               String
  role               Role
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  employee Employee?
  partner  Partner?

  transactionsCreated  Transaction[] @relation("TxnCreatedBy")
  transactionsUpdated  Transaction[] @relation("TxnUpdatedBy")
  transactionsApproved Transaction[] @relation("TxnApprovedBy")
  auditLogs            AuditLog[]
  monthClosesClosed    MonthClose[]  @relation("MonthClosedBy")
  monthClosesReopened  MonthClose[]  @relation("MonthReopenedBy")

  @@map("users")
}

// ============================================================================
// MASTER DATA
// ============================================================================

model Client {
  id        String       @id @default(cuid())
  name      String
  code      String?      @unique
  email     String?
  phone     String?
  notes     String?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  rateHistory           ClientRateHistory[]
  transactions          Transaction[]
  ledgerEntries         ClientLedger[]
  payouts               ClientPayout[]
  productSales          ProductServiceSale[]
  thirdPartySettlements ThirdPartySettlement[]

  @@map("clients")
}

model ClientRateHistory {
  id              String    @id @default(cuid())
  clientId        String    @map("client_id")
  paymentMethodId String    @map("payment_method_id")
  effectiveFrom   DateTime  @map("effective_from")
  effectiveTo     DateTime? @map("effective_to")
  ratePercent     Decimal   @map("rate_percent") @db.Decimal(5, 2)
  feeBasis        FeeBasis  @map("fee_basis")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")

  client        Client        @relation(fields: [clientId], references: [id])
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@index([clientId, paymentMethodId, effectiveFrom])
  @@map("client_rate_history")
}

model Partner {
  id                 String       @id @default(cuid())
  userId             String?      @unique @map("user_id")
  name               String
  profitSharePercent Decimal      @map("profit_share_percent") @db.Decimal(5, 2)
  status             RecordStatus @default(ACTIVE)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  user          User?           @relation(fields: [userId], references: [id])
  ledgerEntries PartnerLedger[]

  @@map("partners")
}

model Company {
  id                String       @id @default(cuid())
  name              String
  legalName         String?      @map("legal_name")
  employeePartnerId String?      @map("employee_partner_id")
  status            RecordStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  employeePartner Employee?     @relation(fields: [employeePartnerId], references: [id])
  merchants       Merchant[]
  transactions    Transaction[]
  expenses        Expense[]
  bankAccounts    BankAccount[]

  @@map("companies")
}

model BusinessUnit {
  id        String       @id @default(cuid())
  name      String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  merchants     Merchant[]
  transactions  Transaction[]
  expenses      Expense[]
  productSales  ProductServiceSale[]
  ledgerEntries BusinessUnitLedger[]

  @@map("business_units")
}

model Employee {
  id                String       @id @default(cuid())
  userId            String?      @unique @map("user_id")
  name              String
  email             String?
  phone             String?
  isEmployeePartner Boolean      @default(false) @map("is_employee_partner")
  salary            Decimal      @default(0) @db.Decimal(18, 2)
  status            RecordStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  user                         User?                   @relation(fields: [userId], references: [id])
  companies                    Company[]
  transactions                 Transaction[]
  employeePartnerLedgerEntries EmployeePartnerLedger[]
  salaryLedgerEntries          SalaryLedger[]
  bonusPoolAllocations         BonusPoolLedger[]

  @@map("employees")
}

model Merchant {
  id                    String   @id @default(cuid())
  name                  String
  companyId             String   @map("company_id")
  businessUnitId        String?  @map("business_unit_id")
  processor             String
  settlementBankId      String   @map("settlement_bank_id")
  dailyLimit            Decimal? @map("daily_limit") @db.Decimal(18, 2)
  monthlyLimit          Decimal? @map("monthly_limit") @db.Decimal(18, 2)
  perTxnLimit           Decimal? @map("per_txn_limit") @db.Decimal(18, 2)
  settlementCycle       String   @map("settlement_cycle")
  defaultReservePercent Decimal  @default(0) @map("default_reserve_percent") @db.Decimal(5, 2)
  active                Boolean  @default(true)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  company        Company       @relation(fields: [companyId], references: [id])
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])
  settlementBank BankAccount   @relation(fields: [settlementBankId], references: [id])

  feeRules          MerchantFeeRule[]
  transactions      Transaction[]
  settlementBatches SettlementBatch[]
  ledgerEntries     MerchantLedger[]

  @@map("merchants")
}

model MerchantFeeRule {
  id              String   @id @default(cuid())
  merchantId      String   @map("merchant_id")
  paymentMethodId String   @map("payment_method_id")
  feePercent      Decimal  @default(0) @map("fee_percent") @db.Decimal(5, 2)
  flatFee         Decimal  @default(0) @map("flat_fee") @db.Decimal(18, 2)
  chargebackFee   Decimal  @default(0) @map("chargeback_fee") @db.Decimal(18, 2)
  refundFee       Decimal  @default(0) @map("refund_fee") @db.Decimal(18, 2)
  monthlyFee      Decimal  @default(0) @map("monthly_fee") @db.Decimal(18, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  merchant      Merchant      @relation(fields: [merchantId], references: [id])
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@unique([merchantId, paymentMethodId])
  @@map("merchant_fee_rules")
}

model BankAccount {
  id                  String            @id @default(cuid())
  name                String
  accountType         AccountType       @map("account_type")
  bankName            String?           @map("bank_name")
  accountNumberMasked String?           @map("account_number_masked")
  currency            String            @default("USD")
  country             String?
  openingBalance      Decimal           @default(0) @map("opening_balance") @db.Decimal(18, 2)
  openingBalanceDate  DateTime?         @map("opening_balance_date")
  active              Boolean           @default(true)
  companyId           String?           @map("company_id")
  status              BankAccountStatus @default(ACTIVE)
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  company               Company?               @relation(fields: [companyId], references: [id])
  merchants             Merchant[]
  transactions          Transaction[]          @relation("TxnExpectedBank")
  settlementBatches     SettlementBatch[]
  payouts               ClientPayout[]
  expenses              Expense[]
  transfersFrom         InternalTransfer[]     @relation("TransferFrom")
  transfersTo           InternalTransfer[]     @relation("TransferTo")
  thirdPartySettlements ThirdPartySettlement[]
  ledgerEntries         BankLedger[]
  reconciliations       BankReconciliation[]

  @@map("bank_accounts")
}

// A point-in-time check of the ledger's book balance against what the real
// bank statement / wallet / cash count shows. Kept as its own append-only
// record (never edited) so there's a durable history of when and by how
// much book and actual drifted, per brief section 5's reconciliation ask.
model BankReconciliation {
  id               String   @id @default(cuid())
  bankAccountId    String   @map("bank_account_id")
  asOfDate         DateTime @map("as_of_date")
  bookBalance      Decimal  @map("book_balance") @db.Decimal(18, 2)
  actualBalance    Decimal  @map("actual_balance") @db.Decimal(18, 2)
  differenceAmount Decimal  @map("difference_amount") @db.Decimal(18, 2)
  notes            String?
  createdById      String   @map("created_by_id")
  createdAt        DateTime @default(now()) @map("created_at")

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])

  @@index([bankAccountId])
  @@map("bank_reconciliations")
}

model PaymentMethod {
  id     String       @id @default(cuid())
  name   String       @unique
  status RecordStatus @default(ACTIVE)

  rateHistory  ClientRateHistory[]
  feeRules     MerchantFeeRule[]
  transactions Transaction[]

  @@map("payment_methods")
}

model PayoutMethod {
  id     String       @id @default(cuid())
  name   String       @unique
  status RecordStatus @default(ACTIVE)

  payouts ClientPayout[]

  @@map("payout_methods")
}

model ExpenseCategory {
  id     String       @id @default(cuid())
  name   String       @unique
  status RecordStatus @default(ACTIVE)

  expenses Expense[]

  @@map("expense_categories")
}

model Vendor {
  id        String       @id @default(cuid())
  name      String
  email     String?
  phone     String?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")

  subscriptions VendorSubscription[]
  expenses      Expense[]

  @@map("vendors")
}

model VendorSubscription {
  id              String       @id @default(cuid())
  vendorId        String       @map("vendor_id")
  name            String
  amount          Decimal      @db.Decimal(18, 2)
  billingCycle    String       @map("billing_cycle")
  nextBillingDate DateTime?    @map("next_billing_date")
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at")

  vendor   Vendor    @relation(fields: [vendorId], references: [id])
  expenses Expense[]

  @@map("vendor_subscriptions")
}

model ProductService {
  id        String       @id @default(cuid())
  name      String
  cost      Decimal      @db.Decimal(18, 2)
  sellPrice Decimal      @map("sell_price") @db.Decimal(18, 2)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")

  sales ProductServiceSale[]

  @@map("products_services")
}

model SettlementParty {
  id        String       @id @default(cuid())
  name      String
  email     String?
  phone     String?
  notes     String?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")

  thirdPartySettlements ThirdPartySettlement[]
  ledgerEntries         ThirdPartyLedger[]

  @@map("settlement_parties")
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ============================================================================
// TRANSACTION ENGINE
// ============================================================================

// Backs the immutable FP-YYYY-MM-###### id sequence (one counter per month).
model TransactionSequence {
  accountingMonth String @id @map("accounting_month")
  lastNumber      Int    @default(0) @map("last_number")

  @@map("transaction_sequences")
}

model Transaction {
  id            String  @id
  parentId      String? @map("parent_id")
  originalTxnId String? @map("original_txn_id")

  transactionDate DateTime  @map("transaction_date")
  processingDate  DateTime? @map("processing_date")
  settlementDate  DateTime? @map("settlement_date")
  accountingMonth String    @map("accounting_month")

  clientId          String  @map("client_id")
  clientReference   String? @map("client_reference")
  companyId         String  @map("company_id")
  merchantId        String  @map("merchant_id")
  expectedBankId    String  @map("expected_bank_id")
  employeePartnerId String? @map("employee_partner_id")
  businessUnitId    String? @map("business_unit_id")
  paymentMethodId   String  @map("payment_method_id")

  grossAmount Decimal @map("gross_amount") @db.Decimal(18, 2)

  // Rate + fee basis are snapshotted at entry time from ClientRateHistory so a
  // later rate change never alters an already-posted transaction.
  fpRatePercent Decimal  @map("fp_rate_percent") @db.Decimal(5, 2)
  feeBasis      FeeBasis @map("fee_basis")
  fpFee         Decimal  @map("fp_fee") @db.Decimal(18, 2)

  merchantFeeManual  Decimal?          @map("merchant_fee_manual") @db.Decimal(18, 2)
  merchantFeeDefault Decimal?          @map("merchant_fee_default") @db.Decimal(18, 2)
  merchantFee        Decimal           @map("merchant_fee") @db.Decimal(18, 2)
  merchantFeeSource  MerchantFeeSource @map("merchant_fee_source")

  feeBearer FeeBearer @map("fee_bearer")

  merchantReservePercent Decimal @default(0) @map("merchant_reserve_percent") @db.Decimal(5, 2)
  merchantReserveAmount  Decimal @default(0) @map("merchant_reserve_amount") @db.Decimal(18, 2)
  fpReservePercent       Decimal @default(0) @map("fp_reserve_percent") @db.Decimal(5, 2)
  fpReserveAmount        Decimal @default(0) @map("fp_reserve_amount") @db.Decimal(18, 2)

  expectedSettlement Decimal  @map("expected_settlement") @db.Decimal(18, 2)
  actualSettlement   Decimal? @map("actual_settlement") @db.Decimal(18, 2)
  settlementBatchId  String?  @map("settlement_batch_id")

  clientNetPayable Decimal? @map("client_net_payable") @db.Decimal(18, 2)

  status TransactionStatus @default(ENTERED)

  documentUrl String? @map("document_url")
  notes       String?
  // Accountant's reason on reject / request-details; distinct from the
  // submitter's own `notes` so neither side's text overwrites the other.
  reviewNotes String? @map("review_notes")

  // Optional reference details, mainly captured on Received transactions.
  customerEmail String? @map("customer_email")
  cardLast4     String? @map("card_last4")

  createdById  String    @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedById  String?   @map("updated_by_id")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  approvedById String?   @map("approved_by_id")
  approvedAt   DateTime? @map("approved_at")

  client          Client           @relation(fields: [clientId], references: [id])
  company         Company          @relation(fields: [companyId], references: [id])
  merchant        Merchant         @relation(fields: [merchantId], references: [id])
  expectedBank    BankAccount      @relation("TxnExpectedBank", fields: [expectedBankId], references: [id])
  employeePartner Employee?        @relation(fields: [employeePartnerId], references: [id])
  businessUnit    BusinessUnit?    @relation(fields: [businessUnitId], references: [id])
  paymentMethod   PaymentMethod    @relation(fields: [paymentMethodId], references: [id])
  settlementBatch SettlementBatch? @relation(fields: [settlementBatchId], references: [id])

  createdBy  User  @relation("TxnCreatedBy", fields: [createdById], references: [id])
  updatedBy  User? @relation("TxnUpdatedBy", fields: [updatedById], references: [id])
  approvedBy User? @relation("TxnApprovedBy", fields: [approvedById], references: [id])

  parent      Transaction?  @relation("TxnParentChain", fields: [parentId], references: [id])
  children    Transaction[] @relation("TxnParentChain")
  originalTxn Transaction?  @relation("TxnOriginalChain", fields: [originalTxnId], references: [id])
  derivedTxns Transaction[] @relation("TxnOriginalChain")

  refundsChargebacksVoids      RefundChargebackVoid[]
  payoutAllocations            ClientPayoutAllocation[]
  adjustments                  Adjustment[]
  clientLedgerEntries          ClientLedger[]
  merchantLedgerEntries        MerchantLedger[]
  bankLedgerEntries            BankLedger[]
  employeePartnerLedgerEntries EmployeePartnerLedger[]
  auditLogs                    AuditLog[]

  @@index([accountingMonth])
  @@index([clientId])
  @@index([merchantId])
  @@index([status])
  @@index([settlementBatchId])
  @@map("transactions")
}

model SettlementBatch {
  id               String                @id @default(cuid())
  merchantId       String                @map("merchant_id")
  bankAccountId    String                @map("bank_account_id")
  depositDate      DateTime              @map("deposit_date")
  accountingMonth  String                @map("accounting_month")
  depositAmount    Decimal               @map("deposit_amount") @db.Decimal(18, 2)
  expectedAmount   Decimal               @default(0) @map("expected_amount") @db.Decimal(18, 2)
  differenceAmount Decimal               @default(0) @map("difference_amount") @db.Decimal(18, 2)
  status           SettlementBatchStatus @default(OPEN)
  notes            String?
  createdById      String                @map("created_by_id")
  createdAt        DateTime              @default(now()) @map("created_at")

  merchant    Merchant    @relation(fields: [merchantId], references: [id])
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])

  transactions Transaction[]

  @@index([accountingMonth])
  @@index([merchantId])
  @@map("settlement_batches")
}

model ClientPayout {
  id              String       @id @default(cuid())
  clientId        String       @map("client_id")
  payoutDate      DateTime     @map("payout_date")
  accountingMonth String       @map("accounting_month")
  payoutMethodId  String       @map("payout_method_id")
  bankAccountId   String       @map("bank_account_id")
  amountPaid      Decimal      @map("amount_paid") @db.Decimal(18, 2)
  remittanceFee   Decimal      @default(0) @map("remittance_fee") @db.Decimal(18, 2)
  feeBearer       FeeBearer    @map("fee_bearer")
  reference       String?
  status          RecordStatus @default(ACTIVE)
  notes           String?
  createdById     String       @map("created_by_id")
  createdAt       DateTime     @default(now()) @map("created_at")

  client       Client       @relation(fields: [clientId], references: [id])
  payoutMethod PayoutMethod @relation(fields: [payoutMethodId], references: [id])
  bankAccount  BankAccount  @relation(fields: [bankAccountId], references: [id])

  allocations   ClientPayoutAllocation[]
  ledgerEntries ClientLedger[]

  @@index([accountingMonth])
  @@index([clientId])
  @@map("client_payouts")
}

// Join table: one payout can cover many transactions, one transaction can
// receive many partial payouts.
model ClientPayoutAllocation {
  id              String  @id @default(cuid())
  clientPayoutId  String  @map("client_payout_id")
  transactionId   String  @map("transaction_id")
  amountAllocated Decimal @map("amount_allocated") @db.Decimal(18, 2)

  clientPayout ClientPayout @relation(fields: [clientPayoutId], references: [id])
  transaction  Transaction  @relation(fields: [transactionId], references: [id])

  @@index([clientPayoutId])
  @@index([transactionId])
  @@map("client_payout_allocations")
}

model RefundChargebackVoid {
  id                    String     @id @default(cuid())
  type                  RcvType
  originalTransactionId String     @map("original_transaction_id")
  accountingMonth       String     @map("accounting_month")
  eventDate             DateTime   @map("event_date")
  amount                Decimal    @db.Decimal(18, 2)
  feeAmount             Decimal    @default(0) @map("fee_amount") @db.Decimal(18, 2)
  feeBearer             FeeBearer? @map("fee_bearer")
  reasonCode            String?    @map("reason_code")
  status                RcvStatus  @default(OPEN)
  notes                 String?
  documentUrl           String?    @map("document_url")
  createdById           String     @map("created_by_id")
  createdAt             DateTime   @default(now()) @map("created_at")
  approvedById          String?    @map("approved_by_id")
  approvedAt            DateTime?  @map("approved_at")

  originalTransaction Transaction @relation(fields: [originalTransactionId], references: [id])

  @@index([accountingMonth])
  @@index([originalTransactionId])
  @@map("refunds_chargebacks_voids")
}

model Expense {
  id                String       @id @default(cuid())
  expenseCategoryId String       @map("expense_category_id")
  vendorId          String?      @map("vendor_id")
  subscriptionId    String?      @map("subscription_id")
  companyId         String?      @map("company_id")
  businessUnitId    String?      @map("business_unit_id")
  bankAccountId     String       @map("bank_account_id")
  amount            Decimal      @db.Decimal(18, 2)
  currency          String       @default("USD")
  expenseDate       DateTime     @map("expense_date")
  accountingMonth   String       @map("accounting_month")
  description       String?
  recurring         Boolean      @default(false)
  status            RecordStatus @default(ACTIVE)
  documentUrl       String?      @map("document_url")
  createdById       String       @map("created_by_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  approvedById      String?      @map("approved_by_id")
  approvedAt        DateTime?    @map("approved_at")

  expenseCategory ExpenseCategory     @relation(fields: [expenseCategoryId], references: [id])
  vendor          Vendor?             @relation(fields: [vendorId], references: [id])
  subscription    VendorSubscription? @relation(fields: [subscriptionId], references: [id])
  company         Company?            @relation(fields: [companyId], references: [id])
  businessUnit    BusinessUnit?       @relation(fields: [businessUnitId], references: [id])
  bankAccount     BankAccount         @relation(fields: [bankAccountId], references: [id])

  bankLedgerEntries BankLedger[]

  @@index([accountingMonth])
  @@map("expenses")
}

model InternalTransfer {
  id                String     @id @default(cuid())
  fromBankAccountId String     @map("from_bank_account_id")
  toBankAccountId   String     @map("to_bank_account_id")
  amount            Decimal    @db.Decimal(18, 2)
  feeAmount         Decimal    @default(0) @map("fee_amount") @db.Decimal(18, 2)
  feeBearer         FeeBearer? @map("fee_bearer")
  transferDate      DateTime   @map("transfer_date")
  accountingMonth   String     @map("accounting_month")
  notes             String?
  createdById       String     @map("created_by_id")
  createdAt         DateTime   @default(now()) @map("created_at")

  fromBankAccount BankAccount @relation("TransferFrom", fields: [fromBankAccountId], references: [id])
  toBankAccount   BankAccount @relation("TransferTo", fields: [toBankAccountId], references: [id])

  bankLedgerEntries BankLedger[]

  @@index([accountingMonth])
  @@map("internal_transfers")
}

model ThirdPartySettlement {
  id                   String              @id @default(cuid())
  settlementPartyId    String              @map("settlement_party_id")
  clientId             String?             @map("client_id")
  relatedTransactionId String?             @map("related_transaction_id")
  direction            ThirdPartyDirection
  amount               Decimal             @db.Decimal(18, 2)
  bankAccountId        String?             @map("bank_account_id")
  settlementDate       DateTime            @map("settlement_date")
  accountingMonth      String              @map("accounting_month")
  notes                String?
  createdById          String              @map("created_by_id")
  createdAt            DateTime            @default(now()) @map("created_at")

  settlementParty SettlementParty @relation(fields: [settlementPartyId], references: [id])
  client          Client?         @relation(fields: [clientId], references: [id])
  bankAccount     BankAccount?    @relation(fields: [bankAccountId], references: [id])

  ledgerEntries ThirdPartyLedger[]

  @@index([accountingMonth])
  @@map("third_party_settlements")
}

model Adjustment {
  id                   String               @id @default(cuid())
  targetType           AdjustmentTargetType @map("target_type")
  targetId             String               @map("target_id")
  relatedTransactionId String?              @map("related_transaction_id")
  amount               Decimal              @db.Decimal(18, 2)
  reason               String
  accountingMonth      String               @map("accounting_month")
  adjustmentDate       DateTime             @map("adjustment_date")
  status               RecordStatus         @default(ACTIVE)
  createdById          String               @map("created_by_id")
  createdAt            DateTime             @default(now()) @map("created_at")
  approvedById         String?              @map("approved_by_id")
  approvedAt           DateTime?            @map("approved_at")

  relatedTransaction Transaction? @relation(fields: [relatedTransactionId], references: [id])

  @@index([accountingMonth])
  @@index([targetType, targetId])
  @@map("adjustments")
}

model ProductServiceSale {
  id                      String   @id @default(cuid())
  productServiceId        String   @map("product_service_id")
  clientId                String?  @map("client_id")
  businessUnitId          String?  @map("business_unit_id")
  quantity                Int      @default(1)
  unitCost                Decimal  @map("unit_cost") @db.Decimal(18, 2)
  unitSellPrice           Decimal  @map("unit_sell_price") @db.Decimal(18, 2)
  totalRevenue            Decimal  @map("total_revenue") @db.Decimal(18, 2)
  totalCost               Decimal  @map("total_cost") @db.Decimal(18, 2)
  saleDate                DateTime @map("sale_date")
  accountingMonth         String   @map("accounting_month")
  deductFromClientBalance Boolean  @default(false) @map("deduct_from_client_balance")
  notes                   String?
  createdById             String   @map("created_by_id")
  createdAt               DateTime @default(now()) @map("created_at")

  productService ProductService @relation(fields: [productServiceId], references: [id])
  client         Client?        @relation(fields: [clientId], references: [id])
  businessUnit   BusinessUnit?  @relation(fields: [businessUnitId], references: [id])

  clientLedgerEntries ClientLedger[]

  @@index([accountingMonth])
  @@map("product_service_sales")
}

// ============================================================================
// SUBLEDGERS (append-only; one row per debit/credit; amount is signed)
// ============================================================================

model ClientLedger {
  id                   String           @id @default(cuid())
  clientId             String           @map("client_id")
  entryDate            DateTime         @map("entry_date")
  accountingMonth      String           @map("accounting_month")
  amount               Decimal          @db.Decimal(18, 2)
  sourceType           LedgerSourceType @map("source_type")
  sourceId             String           @map("source_id")
  transactionId        String?          @map("transaction_id")
  clientPayoutId       String?          @map("client_payout_id")
  productServiceSaleId String?          @map("product_service_sale_id")
  description          String?
  createdById          String           @map("created_by_id")
  createdAt            DateTime         @default(now()) @map("created_at")

  client             Client              @relation(fields: [clientId], references: [id])
  transaction        Transaction?        @relation(fields: [transactionId], references: [id])
  clientPayout       ClientPayout?       @relation(fields: [clientPayoutId], references: [id])
  productServiceSale ProductServiceSale? @relation(fields: [productServiceSaleId], references: [id])

  @@index([accountingMonth])
  @@index([clientId])
  @@map("client_ledger")
}

model MerchantLedger {
  id              String           @id @default(cuid())
  merchantId      String           @map("merchant_id")
  entryDate       DateTime         @map("entry_date")
  accountingMonth String           @map("accounting_month")
  amount          Decimal          @db.Decimal(18, 2)
  sourceType      LedgerSourceType @map("source_type")
  sourceId        String           @map("source_id")
  transactionId   String?          @map("transaction_id")
  description     String?
  createdById     String           @map("created_by_id")
  createdAt       DateTime         @default(now()) @map("created_at")

  merchant    Merchant     @relation(fields: [merchantId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@index([accountingMonth])
  @@index([merchantId])
  @@map("merchant_ledger")
}

model BankLedger {
  id                 String           @id @default(cuid())
  bankAccountId      String           @map("bank_account_id")
  entryDate          DateTime         @map("entry_date")
  accountingMonth    String           @map("accounting_month")
  amount             Decimal          @db.Decimal(18, 2)
  // Manually entered USD value for non-USD accounts (e.g. PKR); no auto FX.
  // Equal to `amount` for USD accounts.
  usdValue           Decimal          @map("usd_value") @db.Decimal(18, 2)
  sourceType         LedgerSourceType @map("source_type")
  sourceId           String           @map("source_id")
  transactionId      String?          @map("transaction_id")
  expenseId          String?          @map("expense_id")
  internalTransferId String?          @map("internal_transfer_id")
  description        String?
  createdById        String           @map("created_by_id")
  createdAt          DateTime         @default(now()) @map("created_at")

  bankAccount      BankAccount       @relation(fields: [bankAccountId], references: [id])
  transaction      Transaction?      @relation(fields: [transactionId], references: [id])
  expense          Expense?          @relation(fields: [expenseId], references: [id])
  internalTransfer InternalTransfer? @relation(fields: [internalTransferId], references: [id])

  @@index([accountingMonth])
  @@index([bankAccountId])
  @@map("bank_ledger")
}

model EmployeePartnerLedger {
  id              String           @id @default(cuid())
  employeeId      String           @map("employee_id")
  entryDate       DateTime         @map("entry_date")
  accountingMonth String           @map("accounting_month")
  amount          Decimal          @db.Decimal(18, 2)
  sourceType      LedgerSourceType @map("source_type")
  sourceId        String           @map("source_id")
  transactionId   String?          @map("transaction_id")
  description     String?
  createdById     String           @map("created_by_id")
  createdAt       DateTime         @default(now()) @map("created_at")

  employee    Employee     @relation(fields: [employeeId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@index([accountingMonth])
  @@index([employeeId])
  @@map("employee_partner_ledger")
}

model PartnerLedger {
  id              String            @id @default(cuid())
  partnerId       String            @map("partner_id")
  entryDate       DateTime          @map("entry_date")
  accountingMonth String            @map("accounting_month")
  amount          Decimal           @db.Decimal(18, 2)
  kind            PartnerLedgerKind
  sourceType      LedgerSourceType  @map("source_type")
  sourceId        String            @map("source_id")
  description     String?
  createdById     String            @map("created_by_id")
  createdAt       DateTime          @default(now()) @map("created_at")

  partner Partner @relation(fields: [partnerId], references: [id])

  @@index([accountingMonth])
  @@index([partnerId])
  @@map("partner_ledger")
}

model BonusPoolLedger {
  id                    String           @id @default(cuid())
  entryDate             DateTime         @map("entry_date")
  accountingMonth       String           @map("accounting_month")
  amount                Decimal          @db.Decimal(18, 2)
  sourceType            LedgerSourceType @map("source_type")
  sourceId              String           @map("source_id")
  allocatedToEmployeeId String?          @map("allocated_to_employee_id")
  allocationDate        DateTime?        @map("allocation_date")
  description           String?
  createdById           String           @map("created_by_id")
  createdAt             DateTime         @default(now()) @map("created_at")

  allocatedToEmployee Employee? @relation(fields: [allocatedToEmployeeId], references: [id])

  @@index([accountingMonth])
  @@map("bonus_pool_ledger")
}

model SalaryLedger {
  id              String           @id @default(cuid())
  employeeId      String           @map("employee_id")
  entryDate       DateTime         @map("entry_date")
  accountingMonth String           @map("accounting_month")
  amount          Decimal          @db.Decimal(18, 2)
  payPeriod       String           @map("pay_period")
  sourceType      LedgerSourceType @map("source_type")
  sourceId        String           @map("source_id")
  description     String?
  createdById     String           @map("created_by_id")
  createdAt       DateTime         @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([accountingMonth])
  @@index([employeeId])
  @@map("salary_ledger")
}

model BusinessUnitLedger {
  id              String           @id @default(cuid())
  businessUnitId  String           @map("business_unit_id")
  entryDate       DateTime         @map("entry_date")
  accountingMonth String           @map("accounting_month")
  amount          Decimal          @db.Decimal(18, 2)
  sourceType      LedgerSourceType @map("source_type")
  sourceId        String           @map("source_id")
  description     String?
  createdById     String           @map("created_by_id")
  createdAt       DateTime         @default(now()) @map("created_at")

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id])

  @@index([accountingMonth])
  @@index([businessUnitId])
  @@map("business_unit_ledger")
}

model ThirdPartyLedger {
  id                     String           @id @default(cuid())
  settlementPartyId      String           @map("settlement_party_id")
  entryDate              DateTime         @map("entry_date")
  accountingMonth        String           @map("accounting_month")
  amount                 Decimal          @db.Decimal(18, 2)
  sourceType             LedgerSourceType @map("source_type")
  sourceId               String           @map("source_id")
  thirdPartySettlementId String?          @map("third_party_settlement_id")
  description            String?
  createdById            String           @map("created_by_id")
  createdAt              DateTime         @default(now()) @map("created_at")

  settlementParty      SettlementParty       @relation(fields: [settlementPartyId], references: [id])
  thirdPartySettlement ThirdPartySettlement? @relation(fields: [thirdPartySettlementId], references: [id])

  @@index([accountingMonth])
  @@index([settlementPartyId])
  @@map("third_party_ledger")
}

// ============================================================================
// CONTROLS
// ============================================================================

model MonthClose {
  accountingMonth String           @id @map("accounting_month")
  status          MonthCloseStatus @default(OPEN)
  checklist       Json?
  closedById      String?          @map("closed_by_id")
  closedAt        DateTime?        @map("closed_at")
  reopenedById    String?          @map("reopened_by_id")
  reopenedAt      DateTime?        @map("reopened_at")
  reopenReason    String?          @map("reopen_reason")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  closedBy   User? @relation("MonthClosedBy", fields: [closedById], references: [id])
  reopenedBy User? @relation("MonthReopenedBy", fields: [reopenedById], references: [id])

  @@map("month_closes")
}

model AuditLog {
  id             String   @id @default(cuid())
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  action         String
  beforeSnapshot Json?    @map("before_snapshot")
  afterSnapshot  Json?    @map("after_snapshot")
  transactionId  String?  @map("transaction_id")
  performedById  String   @map("performed_by_id")
  performedAt    DateTime @default(now()) @map("performed_at")
  notes          String?

  transaction Transaction? @relation(fields: [transactionId], references: [id])
  performedBy User         @relation(fields: [performedById], references: [id])

  @@index([entityType, entityId])
  @@index([performedAt])
  @@map("audit_logs")
}
