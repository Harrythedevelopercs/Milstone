enum AccountCategory {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  COGS
  EXPENSE
}

// Editable reference catalog the standard financial statements (Income
// Statement, Balance Sheet) are organized by and labeled with. This is
// deliberately NOT a full double-entry rewrite of the posting engine --
// every existing subledger (Client/Bank/Merchant/etc.) keeps posting
// exactly as it does today, so none of the existing money math changes.
// The statements map their computed lines to these accounts for standard,
// consistent presentation.
model Account {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  category    AccountCategory
  description String?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("chart_of_accounts")
}

// Whose money a reserve is and which way it's owed -- NOT one-directional.
// CLIENT_HELD: a merchant/processor withholds part of the CLIENT's funds.
//   Still the client's money -- a LIABILITY FoundaPay owes back to them.
//   Release pays the client (bank out, liability down); never touches
//   clientNetPayable itself since it was already excluded from it there.
// FP_FRONTED: FoundaPay puts up its OWN money as a reserve on the client's
//   behalf. The client owes FoundaPay back -- a RECEIVABLE (asset), posted
//   immediately as a client-ledger charge so it shows on their statement.
//   Settling brings cash in and clears the receivable (credits the charge
//   back out).
// FP_OWN: FoundaPay's own reserve, not tied to any client -- an asset that
//   becomes FP's own cash on release, no client-ledger effect ever.
enum ReserveDirection {
  CLIENT_HELD
  FP_FRONTED
  FP_OWN
}

enum ReserveValueType {
  PERCENT
  FIXED
}

enum ReserveActionType {
  RELEASE
  APPLY_TO_CHARGEBACK
  WRITE_OFF
}

// A reserve/hold is money still owed TO FoundaPay by a merchant/processor
// (a receivable asset), not something that vanishes or gets silently
// consumed by a chargeback. One row per transaction+owner (a transaction
// can carry both a client-owned and a FoundaPay-owned reserve at once).
// remainingAmount is a live-computed value (originalAmount minus the sum of
// every action against it) rather than a stored, mutable field, so the
// full resolution history -- partial releases, partial chargeback
// applications, write-offs -- stays append-only and auditable.
model ReserveHold {
  id             String           @id @default(cuid())
  transactionId  String           @map("transaction_id")
  merchantId     String?          @map("merchant_id")
  direction      ReserveDirection
  originalAmount Decimal          @map("original_amount") @db.Decimal(18, 2)
  heldSince      DateTime         @map("held_since")
  createdById    String           @map("created_by_id")
  createdAt      DateTime         @default(now()) @map("created_at")

  transaction Transaction         @relation(fields: [transactionId], references: [id])
  merchant    Merchant?           @relation(fields: [merchantId], references: [id])
  actions     ReserveHoldAction[]

  @@index([transactionId])
  @@index([merchantId])
  @@map("reserve_holds")
}

model ReserveHoldAction {
  id              String            @id @default(cuid())
  reserveHoldId   String            @map("reserve_hold_id")
  type            ReserveActionType
  amount          Decimal           @db.Decimal(18, 2)
  actionDate      DateTime          @map("action_date")
  accountingMonth String            @map("accounting_month")
  // Where the cash landed -- only set for RELEASE.
  bankAccountId   String?           @map("bank_account_id")
  // Which chargeback this offsets -- only set for APPLY_TO_CHARGEBACK.
  rcvId           String?           @map("rcv_id")
  notes           String?
  performedById   String            @map("performed_by_id")
  createdAt       DateTime          @default(now()) @map("created_at")

  reserveHold ReserveHold           @relation(fields: [reserveHoldId], references: [id])
  bankAccount BankAccount?          @relation(fields: [bankAccountId], references: [id])
  rcv         RefundChargebackVoid? @relation(fields: [rcvId], references: [id])

  @@index([reserveHoldId])
  @@index([accountingMonth])
  @@map("reserve_hold_actions")
}
