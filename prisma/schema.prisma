model ClientPayout {
  id              String       @id @default(cuid())
  clientId        String       @map("client_id")
  payoutDate      DateTime     @map("payout_date")
  accountingMonth String       @map("accounting_month")
  payoutMethodId  String       @map("payout_method_id")
  bankAccountId   String       @map("bank_account_id")
  amountPaid      Decimal      @map("amount_paid") @db.Decimal(18, 2)
  // Portion of amountPaid not tied to any specific transaction -- lets one
  // payout mix transaction allocations with a free/general amount. Total
  // out = sum(allocations.amountAllocated) + generalAmount; if that exceeds
  // what the client is owed, the excess is simply an advance (negative
  // client balance), the same as an over-allocated transaction always was.
  generalAmount   Decimal      @default(0) @map("general_amount") @db.Decimal(18, 2)
  remittanceFee   Decimal      @default(0) @map("remittance_fee") @db.Decimal(18, 2)
  feeBearer       FeeBearer    @map("fee_bearer")
  reference       String?
  status          RecordStatus @default(ACTIVE)
  notes           String?
  createdById     String       @map("created_by_id")
  createdAt       DateTime     @default(now()) @map("created_at")

  client       Client       @relation(fields: [clientId], references: [id])
  payoutMethod PayoutMethod @relation(fields: [payoutMethodId], references: [id])
  bankAccount  BankAccount  @relation(fields: [bankAccountId], references: [id])

  allocations   ClientPayoutAllocation[]
  ledgerEntries ClientLedger[]

  @@index([accountingMonth])
  @@index([clientId])
  @@index([payoutDate])
  @@map("client_payouts")
}

// Join table: one payout can cover many transactions, one transaction can
// receive many partial payouts.
model ClientPayoutAllocation {
  id              String  @id @default(cuid())
  clientPayoutId  String  @map("client_payout_id")
  transactionId   String  @map("transaction_id")
  amountAllocated Decimal @map("amount_allocated") @db.Decimal(18, 2)

  clientPayout ClientPayout @relation(fields: [clientPayoutId], references: [id])
  transaction  Transaction  @relation(fields: [transactionId], references: [id])

  @@index([clientPayoutId])
  @@index([transactionId])
  @@map("client_payout_allocations")
}

model RefundChargebackVoid {
  id                    String     @id @default(cuid())
  type                  RcvType
  originalTransactionId String     @map("original_transaction_id")
  accountingMonth       String     @map("accounting_month")
  eventDate             DateTime   @map("event_date")
  amount                Decimal    @db.Decimal(18, 2)
  feeAmount             Decimal    @default(0) @map("fee_amount") @db.Decimal(18, 2)
  feeBearer             FeeBearer? @map("fee_bearer")
  reasonCode            String?    @map("reason_code")
  status                RcvStatus  @default(OPEN)
  notes                 String?
  documentUrl           String?    @map("document_url")
  createdById           String     @map("created_by_id")
  createdAt             DateTime   @default(now()) @map("created_at")
  approvedById          String?    @map("approved_by_id")
  approvedAt            DateTime?  @map("approved_at")

  // Chargeback-only: the customer paid FoundaPay back directly, outside the
