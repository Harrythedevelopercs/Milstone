generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  OWNER
  ACCOUNTANT
  EMPLOYEE
}

enum FeeBasis {
  GROSS
  AFTER_MERCHANT_CHARGES
}

enum FeeBearer {
  FOUNDAPAY
  CLIENT
}

// Purely a manual visibility/workflow flag on Internal Transfers and
// Expenses -- ledger posting already happens immediately at creation
// regardless of this value. PENDING rows are highlighted until someone
// marks them SETTLED.
enum TrackingStatus {
  PENDING
  SETTLED
}

enum MerchantFeeSource {
  MANUAL
  RULE_DEFAULT
}

// How FP's fee on a transaction is derived. PERCENTAGE is the normal,
// rate-driven default; FIXED and NONE are per-transaction overrides an
// accountant can pick instead of the client's configured rate.
enum ChargeType {
  PERCENTAGE
  FIXED
  NONE
}

// Main lifecycle + linked/special states live in one status field on Transaction.
// Linked events (refund/chargeback/void/hold/reserve/dispute) also get their own
// row in RefundChargebackVoid or Adjustment for full detail; this enum reflects
// the transaction's current condition.
enum TransactionStatus {
  ENTERED
  SUBMITTED
  APPROVED
  PROCESSED
  SETTLED
  CLIENT_PAYABLE
  PARTIALLY_PAID
  PAID
  CLOSED
  HOLD
  RESERVE
  VOID
  REFUNDED
  CHARGEBACK
  DISPUTED
  REJECTED
  DETAILS_REQUESTED
}

enum ApprovalAction {
  SUBMIT
  APPROVE
  REJECT
  REQUEST_DETAILS
}

enum MonthCloseStatus {
  OPEN
  CLOSED
  REOPENED
}

// BankAccount doubles as the ledger target for fiat bank, USDT wallets, and cash
// drawers so "cash position" can be reported as one unified list (see brief section 5).
enum AccountType {
  BANK
  USDT
  CASH
}

// Per-company relationship status (from the user's tracking sheet), separate
// from the `active` flag below -- active controls whether an account is
// selectable elsewhere in the app (forms/dropdowns); this only describes
// whether the company currently has/had a real relationship with that bank.
enum BankAccountStatus {
  ACTIVE
  SUSPENDED
  NOT_APPLIED
}

enum RcvType {
  REFUND
  CHARGEBACK
  VOID
}

enum RcvStatus {
  OPEN
  RESOLVED
  DISPUTED
}

enum LedgerSourceType {
  TRANSACTION
  RCV
  PAYOUT
  SETTLEMENT_BATCH
  EXPENSE
  INTERNAL_TRANSFER
  THIRD_PARTY_SETTLEMENT
  ADJUSTMENT
  PRODUCT_SERVICE_SALE
  MONTH_CLOSE
  MANUAL
  RESERVE
}

enum PartnerLedgerKind {
  PROFIT_ENTITLEMENT
  DRAWING
  LOAN
  LOAN_REPAYMENT
  ADJUSTMENT
}

enum AdjustmentTargetType {
  CLIENT
  MERCHANT
  BANK
  EMPLOYEE_PARTNER
  PARTNER
  BUSINESS_UNIT
  THIRD_PARTY
}

enum SettlementBatchStatus {
  OPEN
  RECONCILED
  DIFFERENCE
}

enum ThirdPartyDirection {
  CLIENT_PAYABLE_TO_THIRD_PARTY
  FP_PAID_THIRD_PARTY
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

// ============================================================================
// AUTH / USERS
// ============================================================================

// Credentials + JWT session strategy (no NextAuth DB adapter) -- no Account,
// Session, or VerificationToken tables needed. See schema notes.
model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String    @map("password_hash")
  name               String
  role               Role
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  employee Employee?
  partner  Partner?

  transactionsCreated  Transaction[] @relation("TxnCreatedBy")
  transactionsUpdated  Transaction[] @relation("TxnUpdatedBy")
  transactionsApproved Transaction[] @relation("TxnApprovedBy")
  auditLogs            AuditLog[]
  monthClosesClosed    MonthClose[]  @relation("MonthClosedBy")
  monthClosesReopened  MonthClose[]  @relation("MonthReopenedBy")
  reminders            Reminder[]

  @@map("users")
}

// ============================================================================
// MASTER DATA
// ============================================================================

model Client {
  id                      String            @id @default(cuid())
  name                    String
  code                    String?           @unique
  email                   String?
  phone                   String?
  notes                   String?
  status                  RecordStatus      @default(ACTIVE)
  // Default reserve handling for this client's transactions -- purely a
  // form-default convenience layered on top of the merchant's own default;
  // every field here is nullable ("custom" / no default) and always
  // overridable per transaction. Precedence: per-transaction > this client
  // default > merchant default.
  defaultReserveType      ReserveValueType? @map("default_reserve_type")
  defaultReserveValue     Decimal?          @map("default_reserve_value") @db.Decimal(18, 2)
  defaultReserveDirection ReserveDirection? @map("default_reserve_direction")
  // This client's default fee basis (Gross vs After Merchant Charges) for
  // FP fee/net payout calculations. Null = no override, falls through to
  // the System Settings global default. Always overridable per transaction.
  defaultFeeBasis         FeeBasis?         @map("default_fee_basis")
  // This client's default base for the merchant reserve % calculation (Gross
  // vs After Merchant Charges) -- same precedence/reuse of FeeBasis as
  // defaultFeeBasis above. Null = no override, falls through to the System
  // Settings global default. Always overridable per transaction.
  defaultMerchantReserveBasis FeeBasis?      @map("default_merchant_reserve_basis")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  rateHistory           ClientRateHistory[]
  transactions          Transaction[]
  ledgerEntries         ClientLedger[]
  payouts               ClientPayout[]
  productSales          ProductServiceSale[]
  thirdPartySettlements ThirdPartySettlement[]
  internalTransfers     InternalTransfer[]
  expenses              Expense[]

  @@map("clients")
}

model ClientRateHistory {
  id              String    @id @default(cuid())
  clientId        String    @map("client_id")
  paymentMethodId String    @map("payment_method_id")
  effectiveFrom   DateTime  @map("effective_from")
  effectiveTo     DateTime? @map("effective_to")
  ratePercent     Decimal   @map("rate_percent") @db.Decimal(5, 2)
  feeBasis        FeeBasis  @map("fee_basis")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")

  // Optional split of ratePercent above: a referral partner's share of the
  // combined rate (e.g. Nimra Kashif = Kamal 2% + FoundaPay pure 7.5% =
  // 9.5% combined). Null referralPartnerId = no referral partner, the
  // entire rate is FoundaPay's own revenue. The combined ratePercent still
  // drives the client's fee/payout exactly as before -- this only records
  // who the fee belongs to.
  referralPartnerId          String?  @map("referral_partner_id")
  referralPartnerRatePercent Decimal? @map("referral_partner_rate_percent") @db.Decimal(5, 2)

  client          Client           @relation(fields: [clientId], references: [id])
  paymentMethod   PaymentMethod    @relation(fields: [paymentMethodId], references: [id])
  referralPartner ReferralPartner? @relation(fields: [referralPartnerId], references: [id])

  @@index([clientId, paymentMethodId, effectiveFrom])
  @@map("client_rate_history")
}

model Partner {
  id                 String       @id @default(cuid())
  userId             String?      @unique @map("user_id")
  name               String
  profitSharePercent Decimal      @map("profit_share_percent") @db.Decimal(5, 2)
  status             RecordStatus @default(ACTIVE)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  user          User?           @relation(fields: [userId], references: [id])
  ledgerEntries PartnerLedger[]

  @@map("partners")
}

model Company {
  id                String       @id @default(cuid())
  name              String
  legalName         String?      @map("legal_name")
  employeePartnerId String?      @map("employee_partner_id")
  status            RecordStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  employeePartner Employee?     @relation(fields: [employeePartnerId], references: [id])
  merchants       Merchant[]
  transactions    Transaction[]
  expenses        Expense[]
  bankAccounts    BankAccount[]

  @@map("companies")
}

model BusinessUnit {
  id        String       @id @default(cuid())
  name      String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  merchants     Merchant[]
  transactions  Transaction[]
  expenses      Expense[]
  productSales  ProductServiceSale[]
  ledgerEntries BusinessUnitLedger[]

  @@map("business_units")
}

model Employee {
  id                String       @id @default(cuid())
  userId            String?      @unique @map("user_id")
  name              String
  email             String?
  phone             String?
  isEmployeePartner Boolean      @default(false) @map("is_employee_partner")
  salary            Decimal      @default(0) @db.Decimal(18, 2)
  status            RecordStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  user                         User?                   @relation(fields: [userId], references: [id])
  companies                    Company[]
  transactions                 Transaction[]
  employeePartnerLedgerEntries EmployeePartnerLedger[]
  salaryLedgerEntries          SalaryLedger[]
  bonusPoolAllocations         BonusPoolLedger[]

  @@map("employees")
}

model Merchant {
  id                      String           @id @default(cuid())
  name                    String
  companyId               String           @map("company_id")
  businessUnitId          String?          @map("business_unit_id")
  processor               String
  settlementBankId        String           @map("settlement_bank_id")
  dailyLimit              Decimal?         @map("daily_limit") @db.Decimal(18, 2)
  monthlyLimit            Decimal?         @map("monthly_limit") @db.Decimal(18, 2)
  perTxnLimit             Decimal?         @map("per_txn_limit") @db.Decimal(18, 2)
  settlementCycle         String           @map("settlement_cycle")
  defaultReservePercent   Decimal          @default(0) @map("default_reserve_percent") @db.Decimal(5, 2)
  // Fallback direction when neither the transaction nor the client sets
  // one. Defaults to CLIENT_HELD -- the historical behavior, before
  // per-transaction/client overrides existed.
  defaultReserveDirection ReserveDirection @default(CLIENT_HELD) @map("default_reserve_direction")
  active                  Boolean          @default(true)
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")

  company        Company       @relation(fields: [companyId], references: [id])
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])
  settlementBank BankAccount   @relation(fields: [settlementBankId], references: [id])

  feeRules          MerchantFeeRule[]
  transactions      Transaction[]
  settlementBatches SettlementBatch[]
  ledgerEntries     MerchantLedger[]
  reserveHolds      ReserveHold[]

  @@map("merchants")
}

model MerchantFeeRule {
  id              String   @id @default(cuid())
  merchantId      String   @map("merchant_id")
  paymentMethodId String   @map("payment_method_id")
  feePercent      Decimal  @default(0) @map("fee_percent") @db.Decimal(5, 2)
  flatFee         Decimal  @default(0) @map("flat_fee") @db.Decimal(18, 2)
  chargebackFee   Decimal  @default(0) @map("chargeback_fee") @db.Decimal(18, 2)
  refundFee       Decimal  @default(0) @map("refund_fee") @db.Decimal(18, 2)
  monthlyFee      Decimal  @default(0) @map("monthly_fee") @db.Decimal(18, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  merchant      Merchant      @relation(fields: [merchantId], references: [id])
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@unique([merchantId, paymentMethodId])
  @@map("merchant_fee_rules")
}

model BankAccount {
  id                  String            @id @default(cuid())
  name                String
  accountType         AccountType       @map("account_type")
  bankName            String?           @map("bank_name")
  accountNumberMasked String?           @map("account_number_masked")
  currency            String            @default("USD")
  country             String?
  openingBalance      Decimal           @default(0) @map("opening_balance") @db.Decimal(18, 2)
  openingBalanceDate  DateTime?         @map("opening_balance_date")
  active              Boolean           @default(true)
  companyId           String?           @map("company_id")
  status              BankAccountStatus @default(ACTIVE)
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  company               Company?               @relation(fields: [companyId], references: [id])
  merchants             Merchant[]
  transactions          Transaction[]          @relation("TxnExpectedBank")
  settlementBatches     SettlementBatch[]
  payouts               ClientPayout[]
  expenses              Expense[]
  transfersFrom         InternalTransfer[]     @relation("TransferFrom")
  transfersTo           InternalTransfer[]     @relation("TransferTo")
  thirdPartySettlements ThirdPartySettlement[]
  ledgerEntries         BankLedger[]
  reconciliations       BankReconciliation[]
  rcvFulfillments       RefundChargebackVoid[]
  reserveHoldActions    ReserveHoldAction[]

  @@map("bank_accounts")
}

// A point-in-time check of the ledger's book balance against what the real
// bank statement / wallet / cash count shows. Kept as its own append-only
// record (never edited) so there's a durable history of when and by how
// much book and actual drifted, per brief section 5's reconciliation ask.
model BankReconciliation {
  id               String   @id @default(cuid())
  bankAccountId    String   @map("bank_account_id")
  asOfDate         DateTime @map("as_of_date")
  bookBalance      Decimal  @map("book_balance") @db.Decimal(18, 2)
  actualBalance    Decimal  @map("actual_balance") @db.Decimal(18, 2)
  differenceAmount Decimal  @map("difference_amount") @db.Decimal(18, 2)
  notes            String?
  createdById      String   @map("created_by_id")
  createdAt        DateTime @default(now()) @map("created_at")

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])

  @@index([bankAccountId])
  @@map("bank_reconciliations")
}

model PaymentMethod {
  id               String       @id @default(cuid())
  name             String       @unique
  status           RecordStatus @default(ACTIVE)
  // false = direct-to-bank (Wire, Cash, ACH, USDT, Zelle by default) -- no
  // merchant/processor involved, funds land straight in a chosen bank account.
  requiresMerchant Boolean      @default(true) @map("requires_merchant")

  rateHistory  ClientRateHistory[]
  feeRules     MerchantFeeRule[]
  transactions Transaction[]

  @@map("payment_methods")
}

model PayoutMethod {
  id     String       @id @default(cuid())
  name   String       @unique
  status RecordStatus @default(ACTIVE)

  payouts ClientPayout[]

  @@map("payout_methods")
}

model ExpenseCategory {
  id     String       @id @default(cuid())
  name   String       @unique
  status RecordStatus @default(ACTIVE)

  expenses Expense[]

  @@map("expense_categories")
}

// An external person/company who earns a referral share of FoundaPay's fee
// on a specific client's transactions (e.g. Kamal earning 2% out of Nimra
// Kashif's 9.5% combined rate) -- deliberately separate from Employee
// (FoundaPay's own payroll staff) and Partner (equity/profit-share owners),
// since a referral relationship is neither.
model ReferralPartner {
  id        String       @id @default(cuid())
  name      String
  status    RecordStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  rateHistoryEntries ClientRateHistory[]
  transactions       Transaction[]

  @@map("referral_partners")
}

model Vendor {
  id        String       @id @default(cuid())
  name      String
  email     String?
  phone     String?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")

  subscriptions VendorSubscription[]
  expenses      Expense[]

  @@map("vendors")
}

model VendorSubscription {
  id              String       @id @default(cuid())
  vendorId        String       @map("vendor_id")
  name            String
  amount          Decimal      @db.Decimal(18, 2)
  billingCycle    String       @map("billing_cycle")
  nextBillingDate DateTime?    @map("next_billing_date")
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at")

  vendor   Vendor    @relation(fields: [vendorId], references: [id])
  expenses Expense[]

  @@map("vendor_subscriptions")
}

model ProductService {
  id        String       @id @default(cuid())
  name      String
  cost      Decimal      @db.Decimal(18, 2)
  sellPrice Decimal      @map("sell_price") @db.Decimal(18, 2)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")

  sales ProductServiceSale[]

  @@map("products_services")
}

model SettlementParty {
  id        String       @id @default(cuid())
  name      String
  email     String?
  phone     String?
  notes     String?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")

  thirdPartySettlements ThirdPartySettlement[]
  ledgerEntries         ThirdPartyLedger[]

  @@map("settlement_parties")
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ============================================================================
// TRANSACTION ENGINE
// ============================================================================

// Backs the immutable FP-YYYY-MM-###### id sequence (one counter per month).
model TransactionSequence {
  accountingMonth String @id @map("accounting_month")
  lastNumber      Int    @default(0) @map("last_number")

  @@map("transaction_sequences")
}

model Transaction {
  id            String  @id
  parentId      String? @map("parent_id")
  originalTxnId String? @map("original_txn_id")

  transactionDate DateTime  @map("transaction_date")
  processingDate  DateTime? @map("processing_date")
  settlementDate  DateTime? @map("settlement_date")
  accountingMonth String    @map("accounting_month")

  clientId          String  @map("client_id")
  clientReference   String? @map("client_reference")
  // Null for direct-to-bank payments (no merchant/processor involved) --
  // companyId is then derived from the chosen bank account's company, if any.
  companyId         String? @map("company_id")
  merchantId        String? @map("merchant_id")
  expectedBankId    String  @map("expected_bank_id")
  employeePartnerId String? @map("employee_partner_id")
  businessUnitId    String? @map("business_unit_id")
  paymentMethodId   String  @map("payment_method_id")

  grossAmount Decimal @map("gross_amount") @db.Decimal(18, 2)

  // Rate is snapshotted at entry time from ClientRateHistory so a later rate
  // change never alters an already-posted transaction. Fee basis is
  // resolved at entry time from the three-level precedence (per-transaction
  // override > client default > System Settings global default -- see
  // src/lib/transactions/fee-basis.ts), NOT from ClientRateHistory.feeBasis
  // (that field still exists per rate period but no longer drives the
  // calculation, kept only for historical rate records).
  fpRatePercent     Decimal  @map("fp_rate_percent") @db.Decimal(5, 2)
  feeBasis          FeeBasis @map("fee_basis")
  // Gross minus the merchant's processing fee -- the base FP's fee is
  // calculated on when feeBasis is AFTER_MERCHANT_CHARGES (equals grossAmount
  // when feeBasis is GROSS, since nothing is netted out in that case).
  netAmountReceived Decimal  @map("net_amount_received") @db.Decimal(18, 2)
  fpFee             Decimal  @map("fp_fee") @db.Decimal(18, 2)

  // Split of fpFee above between a referral partner's share and FoundaPay's
  // own revenue -- snapshotted at entry/edit time from the client rate
  // period in effect, same as fpRatePercent itself. Always
  // referralPartnerFee + foundapayPureFee == fpFee exactly; null
  // referralPartnerId means no referral partner (foundapayPureFee == fpFee,
  // referralPartnerFee == 0). This never changes what the client is
  // charged -- fpFee (and clientNetPayable) are computed exactly as before.
  referralPartnerId          String?  @map("referral_partner_id")
  referralPartnerRatePercent Decimal? @map("referral_partner_rate_percent") @db.Decimal(5, 2)
  referralPartnerFee         Decimal  @default(0) @map("referral_partner_fee") @db.Decimal(18, 2)
  foundapayPureFee           Decimal  @map("foundapay_pure_fee") @db.Decimal(18, 2)

  // Defaults to PERCENTAGE (fpRatePercent x feeBasis, the client's configured
  // rate). FIXED overrides fpFee with fixedChargeAmount regardless of gross;
  // NONE forces fpFee to 0. fpFee itself always holds the final computed
  // dollar amount either way, so every downstream consumer keeps reading it.
  chargeType        ChargeType @default(PERCENTAGE) @map("charge_type")
  fixedChargeAmount Decimal?   @map("fixed_charge_amount") @db.Decimal(18, 2)

  merchantFeeManual  Decimal?          @map("merchant_fee_manual") @db.Decimal(18, 2)
  merchantFeeDefault Decimal?          @map("merchant_fee_default") @db.Decimal(18, 2)
  merchantFee        Decimal           @map("merchant_fee") @db.Decimal(18, 2)
  merchantFeeSource  MerchantFeeSource @map("merchant_fee_source")

  feeBearer FeeBearer @map("fee_bearer")

  merchantReservePercent Decimal @default(0) @map("merchant_reserve_percent") @db.Decimal(5, 2)
  // Base the merchant reserve % is applied to -- resolved at entry time from
  // the same three-level precedence as feeBasis (per-transaction > client
  // default > System Settings global default -- see
  // src/lib/transactions/reserve-basis.ts). Snapshotted so a later setting
  // change never alters an already-posted transaction.
  merchantReserveBasis   FeeBasis @default(GROSS) @map("merchant_reserve_basis")
  merchantReserveAmount  Decimal @default(0) @map("merchant_reserve_amount") @db.Decimal(18, 2)
  fpReservePercent       Decimal @default(0) @map("fp_reserve_percent") @db.Decimal(5, 2)
  fpReserveAmount        Decimal @default(0) @map("fp_reserve_amount") @db.Decimal(18, 2)

  expectedSettlement Decimal  @map("expected_settlement") @db.Decimal(18, 2)
  actualSettlement   Decimal? @map("actual_settlement") @db.Decimal(18, 2)
  settlementBatchId  String?  @map("settlement_batch_id")

  clientNetPayable Decimal? @map("client_net_payable") @db.Decimal(18, 2)

  status TransactionStatus @default(ENTERED)

  documentUrl String? @map("document_url")
  notes       String?
  // Accountant's reason on reject / request-details; distinct from the
  // submitter's own `notes` so neither side's text overwrites the other.
  reviewNotes String? @map("review_notes")

  // Optional reference details, mainly captured on Received transactions.
  customerEmail String? @map("customer_email")
  cardLast4     String? @map("card_last4")

  createdById  String    @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedById  String?   @map("updated_by_id")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  approvedById String?   @map("approved_by_id")
  approvedAt   DateTime? @map("approved_at")

  client          Client           @relation(fields: [clientId], references: [id])
  company         Company?         @relation(fields: [companyId], references: [id])
  merchant        Merchant?        @relation(fields: [merchantId], references: [id])
  expectedBank    BankAccount      @relation("TxnExpectedBank", fields: [expectedBankId], references: [id])
  employeePartner Employee?        @relation(fields: [employeePartnerId], references: [id])
  businessUnit    BusinessUnit?    @relation(fields: [businessUnitId], references: [id])
  paymentMethod   PaymentMethod    @relation(fields: [paymentMethodId], references: [id])
  settlementBatch SettlementBatch? @relation(fields: [settlementBatchId], references: [id])
  referralPartner ReferralPartner? @relation(fields: [referralPartnerId], references: [id])

  createdBy  User  @relation("TxnCreatedBy", fields: [createdById], references: [id])
  updatedBy  User? @relation("TxnUpdatedBy", fields: [updatedById], references: [id])
  approvedBy User? @relation("TxnApprovedBy", fields: [approvedById], references: [id])

  parent      Transaction?  @relation("TxnParentChain", fields: [parentId], references: [id])
  children    Transaction[] @relation("TxnParentChain")
  originalTxn Transaction?  @relation("TxnOriginalChain", fields: [originalTxnId], references: [id])
  derivedTxns Transaction[] @relation("TxnOriginalChain")

  refundsChargebacksVoids      RefundChargebackVoid[]
  payoutAllocations            ClientPayoutAllocation[]
  adjustments                  Adjustment[]
  clientLedgerEntries          ClientLedger[]
  merchantLedgerEntries        MerchantLedger[]
  bankLedgerEntries            BankLedger[]
  employeePartnerLedgerEntries EmployeePartnerLedger[]
  auditLogs                    AuditLog[]
  reminders                    Reminder[]
  reserveHolds                 ReserveHold[]

  @@index([accountingMonth])
  @@index([clientId])
