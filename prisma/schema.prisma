enum ReminderType {
  // Created via the Hold action -- previousStatus is set so releasing the
  // hold can restore exactly what the transaction was before.
  TRANSACTION
  // Fully freeform: title/note/date the accountant typed in themselves, or
  // a follow-up reminder attached to a transaction that isn't a hold (e.g.
  // "check on this merchant's reserve release").
  CUSTOM
}

enum ReminderStatus {
  OPEN
  DONE
  DISMISSED
}

